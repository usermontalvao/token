{
  "manifest_version": 3,
  "name": "Jurius Token Bridge MVP",
  "short_name": "Token Bridge",
  "version": "0.1.0",
  "description": "Conecta temporariamente o certificado A3 do escritorio por uma rede privada.",
  "minimum_chrome_version": "116",
  "key": "",
  "action": {
    "default_title": "Certificado Digital",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}

