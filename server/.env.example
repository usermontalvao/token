VH_SERVER_NAME=Jurius Token Office
VH_BIND_ADDRESS=10.254.75.75
VH_TCP_PORT=7575

# Descubra com `lsusb`. Exemplo ficticio: 1234/abcd.
# Mais de um identificador pode ser separado por virgula.
VH_ALLOWED_DEVICES=1234/abcd

# Comece com 0. Se o kernel Linux capturar o token e o redirecionamento falhar,
# teste ClaimPorts=1 com o token ligado diretamente, sem hub USB externo.
VH_AUTO_ATTACH_TO_KERNEL=0
VH_CLAIM_PORTS=0

# Opcional: fixe o SHA-256 do binario oficial aprovado pelo escritorio. Sem
# esse valor, o build confere o SHA-1 publicado pelo proprio VirtualHere.
VH_SHA256=

# Somente se optar pelo profile cloudflare do compose.
CLOUDFLARE_TUNNEL_TOKEN=
